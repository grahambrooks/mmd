%% showcase: erDiagram
%% prose: Entities are tables of typed attributes with their keys and comments, placed by the same layered layout as flowcharts. Relationships carry a crow's foot for the cardinality at each end; non-identifying ones are dashed.
%% approx: No alternating row shading or column rules as mermaid draws.
erDiagram
    %% An online shop's order schema.
    CUSTOMER ||--o{ ORDER : places
    CUSTOMER |o--o| ADDRESS : "ships to"
    ORDER ||--|{ LINE_ITEM : contains
    PRODUCT ||--o{ LINE_ITEM : "ordered as"
    CATEGORY |o..o{ PRODUCT : groups
    CATEGORY |o--o{ CATEGORY : "parent of"

    CUSTOMER {
        int id PK
        string email UK "login"
        string name
    }
    ADDRESS {
        int id PK
        int customer_id FK
        string postcode
    }
    ORDER {
        int id PK
        int customer_id FK
        date placed_on
        string status "pending, paid, shipped"
    }
    LINE_ITEM {
        int order_id PK, FK
        int product_id PK, FK
        int quantity
        decimal unit_price "at time of order"
    }
    PRODUCT {
        int id PK
        string sku UK
        string title
        int category_id FK
    }
    CATEGORY {
        int id PK
        string name
        int parent_id FK "null at the root"
    }
