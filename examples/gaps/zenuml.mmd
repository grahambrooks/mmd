%% showcase: zenuml — an external plugin
%% type: zenuml
%% prose: ZenUML is not part of mermaid itself: it is an external plugin (`@mermaid-js/mermaid-zenuml`) with its own code-like grammar, registered at runtime. mmd does not implement it; `sequenceDiagram` draws the same kind of picture.
zenuml
    title Borrowing a book
    @Actor Alice
    BookLibService.Borrow(id) {
      User = Session.GetUser()
      if(User.isActive) {
        receipt = new Receipt(id, dueDate)
      }
      return receipt
    }
