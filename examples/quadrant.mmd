%% showcase: quadrantChart with styled points
%% prose: Four tinted quadrants with their labels near the top, axis labels outside the square, and points placed by their 0 to 1 coordinates. Two points carry their own colour, radius and outline, one through a classDef.
%% approx: The y-axis labels are horizontal and wrapped beside the square; mermaid rotates them to run up its left edge.
%% approx: Quadrant tints are the theme's blues rather than shades of mermaid's primary colour, and an outline wider than 2 px is drawn at 2 px.
quadrantChart
    title Which diagram types to build next
    x-axis Low cost --> High cost
    y-axis Rarely written --> Often written
    quadrant-1 Plan carefully
    quadrant-2 Build now
    quadrant-3 Defer
    quadrant-4 Avoid
    sequence: [0.62, 0.92]
    state: [0.38, 0.74]
    class: [0.55, 0.58]
    pie: [0.08, 0.55] radius: 8, color: #1a7f37
    gantt: [0.45, 0.48]
    timeline: [0.2, 0.3]
    architecture:::costly: [0.9, 0.2]
    classDef costly color: #cf222e, radius: 9, stroke-color: #57060c, stroke-width: 3px
