%% showcase: radar-beta with a polygon graticule
%% prose: With `graticule polygon` the rings and the curves are straight-sided; `min` and `max` fix the scale, so a value beyond `max` is drawn at the rim. `showLegend false` drops the legend.
radar-beta:
    axis q1["Q1"], q2["Q2"], q3["Q3"], q4["Q4"], q5["Q5"]
    curve plan["Plan"]{60, 70, 80, 90, 100}
    curve actual["Actual"]{55, 72, 64, 95, 130}
    graticule polygon
    min 40, max 120
    ticks 4
    showLegend false
