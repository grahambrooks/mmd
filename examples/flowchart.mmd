%% showcase: flowchart
%% prose: Nodes are ranked along the flow by a layered layout that keeps crossings down and subgraph members together; links are smooth curves that leave and arrive square to the flow.
%% approx: Layout is mmd's own layered algorithm, not dagre, so node positions differ from mermaid's.
flowchart TD
    %% A request through the editor's preview pipeline.
    edit([Keystroke]) --> buffer[Buffer changes]
    buffer --> debounce{Paused 150 ms?}
    debounce -->|no| buffer
    debounce -->|yes| worker[[Render on a worker]]
    subgraph tools [The user's crates]
        worker --> mmd[mmd: Mermaid]
        worker --> puml[puml: PlantUML]
        worker --> forge[forge: architecture]
    end
    mmd & puml & forge --> scene[(Scene)]
    scene ==> paint>Paint natively]
    scene -.-> svg[/SVG for files/]
    paint --o done((Shown))
    svg --x failed{{Unsupported}}
    svg --> pdf@{ shape: doc, label: "PDF via **md2pdf**" }
    classDef hot fill:#f9d77e,stroke:#b8860b,color:#222
    class debounce hot
    style tools fill:#eef4fb,stroke:#5b7fa6,color:#2b4a6f
    linkStyle 2 stroke:#b8860b,stroke-width:2px,color:#b8860b
