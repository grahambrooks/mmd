%% showcase: venn-beta of a team's skills
%% prose: Three overlapping sets with their intersections labelled. Each region lists its `text` items under the set or union label; `style` colours a set's outline and an item's text.
%% approx: Circles sit in a fixed symmetric arrangement; mermaid sizes and places them with venn.js so areas follow each set's and union's size. Here a size only scales its circle's radius slightly.
%% approx: Circles are outlined, not filled with mermaid's translucent tint; a union's `fill` colours its label instead of shading the lens.
%% approx: More than three sets is an error (mermaid draws any number).
venn-beta
    title Who knows what
    set FE["Frontend"]:20
        text react["React"]
        text css["CSS"]
    set BE["Backend"]:18
        text rust["Rust"]
        text sql["SQL"]
    set OPS["Operations"]:12
        text k8s["Kubernetes"]
    union FE,BE["APIs"]
        text openapi["OpenAPI"]
    union BE,OPS["Deploys"]
    union FE,OPS["CDN"]
    union FE,BE,OPS["On call"]
    style FE fill:#e8590c
    style react color:#1971c2
