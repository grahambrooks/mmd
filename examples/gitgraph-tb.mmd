%% showcase: gitGraph, top to bottom
%% prose: The same model top to bottom: lanes run down the page in their `order:`, commit labels sit left of each commit and tags to its right. The fix is cherry-picked onto release, marked with mermaid's cherry; the merge carries its own id and tag.
%% approx: Tags sit flat beside the commit; mermaid rotates them 45 degrees in TB/BT.
gitGraph TB:
    commit id: "init"
    branch release order: 2
    branch develop order: 1
    commit id: "parser"
    commit id: "fix crash" type: HIGHLIGHT
    checkout release
    cherry-pick id: "fix crash"
    commit id: "notes" tag: "v1.0.1"
    checkout develop
    commit id: "layout"
    checkout main
    merge develop id: "ship" tag: "v1.1"
