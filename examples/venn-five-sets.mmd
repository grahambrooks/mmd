%% showcase: venn-beta with five sets
%% prose: Five or more sets draw as an Euler diagram: sets that share a `union` or a `text` overlap, the rest keep apart, and each label sits in the region of exactly the sets it names.
%% approx: Five or more sets are circles relaxed from a ring by a fixed number of rounds, not venn.js's area-proportional optimisation; regions no `union` or `text` names may appear or vanish. When the circles cannot form every named region, five sets switch to five ellipses instead.
%% approx: A size only scales its circle's radius slightly (70–100% of the largest).
venn-beta
    title Languages across teams
    set Web:20
        text TypeScript
    set Mobile:14
        text Swift
    set Backend:20
        text Go
    set Data:16
        text Python
    set Infra:10
        text HCL
    union Web,Mobile["Kotlin"]
    union Web,Backend["Node"]
    union Backend,Data["SQL"]
    union Backend,Infra["Bash"]
    union Web,Mobile,Backend["GraphQL"]
